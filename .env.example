# Copy to .env for local overrides. Never commit real credentials.
# Compose interpolates POSTGRES_* and LAB_BIND_ADDRESS (see docker-compose*.yml).

COMPOSE_PROJECT_NAME=docker-hacking-lab
POSTGRES_USER=admin
POSTGRES_PASSWORD=lab-only-password
POSTGRES_DB=corporate_secrets
LAB_BIND_ADDRESS=127.0.0.1

